+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from typing import Any
+
+from tests.parser.engine.replay_harness import MockTokenizer
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.chat_completion.serving import (
+    _continued_final_reasoning_parse_prefix,
+    _parse_nonstream_chat_output,
+)
+from vllm.parser.parser_manager import ParserManager
+
+THINK_START = 50
+THINK_END = 51
+OUTPUT_IDS = [420, 446, 1]
+OUTPUT_TEXT = "D E"
+PROMPT_IDS = [7, THINK_START, 410, THINK_END, 419]
+TOOL_TEXT = (
+    '<｜DSML｜ calls><｜DSML｜ invoke name="ping">'
+    '<｜DSML｜ parameter name="x" string="false">1</｜DSML｜ parameter>'
+    "</｜DSML｜ invoke></｜DSML｜ calls>"
+)
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "ping",
+            "parameters": {
+                "type": "object",
+                "properties": {"x": {"type": "integer"}},
+            },
+        },
+    }
+]
+
+
+def _tokenizer() -> MockTokenizer:
+    return MockTokenizer(
+        {"<think>": THINK_START, "</think>": THINK_END},
+        [
+            (THINK_START, "<think>"),
+            (THINK_END, "</think>"),
+            (410, "closed reasoning"),
+            (419, "C"),
+            (420, "D"),
+            (446, " E"),
+            (421, TOOL_TEXT),
+            (1, ""),
+        ],
+    )
+
+
+def _request(
+    messages: list[dict[str, Any]],
+    *,
+    continue_final_message: bool,
+    reasoning_effort: str = "low",
+    tools: list[dict[str, Any]] | None = None,
+) -> ChatCompletionRequest:
+    return ChatCompletionRequest.model_validate(
+        {
+            "model": "test-model",
+            "messages": messages,
+            "add_generation_prompt": not continue_final_message,
+            "continue_final_message": continue_final_message,
+            "chat_template_kwargs": {"reasoning_effort": reasoning_effort},
+            "tools": tools,
+        }
+    )
+
+
+def _parser(
+    *,
+    reasoning_effort: str = "low",
+    tools: list[dict[str, Any]] | None = None,
+    parser_name: str = "deepseek_v41",
+):
+    parser_cls = ParserManager.get_parser(
+        tool_parser_name=parser_name if tools else None,
+        reasoning_parser_name=parser_name,
+        enable_auto_tools=bool(tools),
+    )
+    assert parser_cls is not None
+    return parser_cls(
+        _tokenizer(),
+        tools,
+        chat_template_kwargs={"reasoning_effort": reasoning_effort},
+    )
+
+
+def test_content_only_continuation_nonstream_matches_streaming():
+    # DeepSeek V4.1 emits THINK_END before nonempty assistant content even when
+    # the request did not carry a dedicated reasoning field.
+    messages = [{"role": "assistant", "content": "C"}]
+    request = _request(messages, continue_final_message=True)
+
+    reasoning, content, tool_calls, reasoning_tokens = _parse_nonstream_chat_output(
+        _parser(),
+        request,
+        messages,
+        PROMPT_IDS,
+        OUTPUT_TEXT,
+        OUTPUT_IDS,
+        enable_auto_tools=False,
+    )
+    stream_delta = _parser().parse_delta(
+        OUTPUT_TEXT,
+        OUTPUT_IDS,
+        request,
+        prompt_token_ids=PROMPT_IDS,
+        finished=True,
+    )
+
+    assert reasoning is None
+    assert content == OUTPUT_TEXT
+    assert tool_calls == []
+    assert reasoning_tokens == 0
+    assert stream_delta is not None
+    assert stream_delta.reasoning is None
+    assert stream_delta.content == OUTPUT_TEXT
+
+
+def test_open_reasoning_continuation_remains_reasoning():
+    messages = [
+        {"role": "assistant", "reasoning": "still open", "content": ""}
+    ]
+    request = _request(messages, continue_final_message=True)
+    parser = _parser()
+
+    assert (
+        _continued_final_reasoning_parse_prefix(
+            request, messages, parser, [7, THINK_START, 410]
+        )
+        is None
+    )
+    reasoning, content, _, _ = _parse_nonstream_chat_output(
+        parser,
+        request,
+        messages,
+        [7, THINK_START, 410],
+        OUTPUT_TEXT,
+        OUTPUT_IDS,
+        enable_auto_tools=False,
+    )
+    assert reasoning == OUTPUT_TEXT
+    assert content is None
+
+
+def test_normal_turn_and_reasoning_disabled_are_unchanged():
+    normal_messages = [{"role": "user", "content": "continue"}]
+    normal_request = _request(normal_messages, continue_final_message=False)
+    normal_reasoning, normal_content, _, _ = _parse_nonstream_chat_output(
+        _parser(),
+        normal_request,
+        normal_messages,
+        [7],
+        OUTPUT_TEXT,
+        OUTPUT_IDS,
+        enable_auto_tools=False,
+    )
+    assert normal_reasoning == OUTPUT_TEXT
+    assert normal_content is None
+
+    closed_messages = [
+        {"role": "assistant", "reasoning": "ignored", "content": "C"}
+    ]
+    disabled_request = _request(
+        closed_messages,
+        continue_final_message=True,
+        reasoning_effort="none",
+    )
+    disabled_reasoning, disabled_content, _, disabled_tokens = (
+        _parse_nonstream_chat_output(
+            _parser(reasoning_effort="none"),
+            disabled_request,
+            closed_messages,
+            PROMPT_IDS,
+            OUTPUT_TEXT,
+            OUTPUT_IDS,
+            enable_auto_tools=False,
+        )
+    )
+    assert disabled_reasoning is None
+    assert disabled_content == OUTPUT_TEXT
+    assert disabled_tokens == 0
+
+
+def test_user_content_sentinel_cannot_activate_prefix():
+    # A literal spelling remains ordinary text and therefore supplies no
+    # configured THINK_END token. A later THINK_START also reopens reasoning.
+    messages = [{"role": "assistant", "content": "literal </think> text"}]
+    request = _request(messages, continue_final_message=True)
+    parser = _parser()
+
+    assert _continued_final_reasoning_parse_prefix(
+        request, messages, parser, [7, 600, 601]
+    ) is None
+    assert _continued_final_reasoning_parse_prefix(
+        request, messages, parser, [7, THINK_END, 600, THINK_START, 601]
+    ) is None
+
+
+def test_other_reasoning_parser_with_same_marker_is_unchanged():
+    messages = [{"role": "assistant", "content": "C"}]
+    request = _request(messages, continue_final_message=True)
+
+    assert _continued_final_reasoning_parse_prefix(
+        request,
+        messages,
+        _parser(parser_name="deepseek_v4"),
+        PROMPT_IDS,
+    ) is None
+
+
+def test_closed_reasoning_continuation_still_parses_tools():
+    messages = [{"role": "assistant", "content": "C"}]
+    request = _request(messages, continue_final_message=True, tools=TOOLS)
+    reasoning, content, tool_calls, reasoning_tokens = _parse_nonstream_chat_output(
+        _parser(tools=TOOLS),
+        request,
+        messages,
+        PROMPT_IDS,
+        TOOL_TEXT,
+        [421],
+        enable_auto_tools=True,
+    )
+
+    assert reasoning is None
+    assert content is None
+    assert tool_calls is not None
+    assert [(call.name, call.arguments) for call in tool_calls] == [
+        ("ping", '{"x": 1}')
+    ]
+    assert reasoning_tokens == 0
