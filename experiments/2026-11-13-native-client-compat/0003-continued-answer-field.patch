+def _continued_final_reasoning_parse_prefix(
+    request: ChatCompletionRequest,
+    conversation: list[ConversationMessage],
+    parser: Parser,
+    prompt_token_ids: list[int] | None,
+) -> tuple[str, tuple[int, ...]] | None:
+    """Return a parser-only reasoning closer for a closed assistant prefix.
+
+    A non-streaming parser normally sees only generated tokens, so an output
+    continuing an assistant message whose reasoning closed in the prompt would
+    otherwise be parsed from the reasoner's initial REASONING state. Streaming
+    avoids this by inspecting ``prompt_token_ids`` before its first delta.
+
+    Keep this narrowly tied to the DeepSeek V4.1 parser and the matching
+    chat-template case: an assistant ``continue_final_message`` with content or
+    tool calls. The parser's actual end-token ID must occur in the rendered
+    prompt. We deliberately do not search message text, so a literal
+    reasoning-end spelling supplied as content cannot activate this path.
+    """
+    if (
+        not request.continue_final_message
+        or not conversation
+        or not prompt_token_ids
+    ):
+        return None
+
+    final_message = conversation[-1]
+    if final_message.get("role") != "assistant":
+        return None
+    if not final_message.get("content") and not final_message.get("tool_calls"):
+        # The template leaves a reasoning-only assistant prefix open.
+        return None
+
+    reasoner = parser.reasoning_parser
+    if reasoner is None:
+        return None
+
+    # The same marker protocol is used by several model families. Limit this
+    # compatibility shim to the active DeepSeek V4.1 adapter and its engine.
+    from vllm.parser.deepseek_v41 import DeepSeekV41Parser
+    from vllm.parser.engine.registered_adapters import (
+        DeepSeekV41ParserReasoningAdapter,
+    )
+
+    if (
+        not isinstance(reasoner, DeepSeekV41ParserReasoningAdapter)
+        or reasoner._parser_engine_cls is not DeepSeekV41Parser
+        or not parser.is_reasoning_end(prompt_token_ids)
+    ):
+        return None
+    end_text = reasoner.reasoning_end_str
+    end_token_ids = reasoner.reasoning_end_token_ids
+    if not end_text or not end_token_ids:
+        return None
+
+    # Reuse the exact end token emitted by the template. In particular, do not
+    # tokenize a sentinel spelling from request-controlled text.
+    end_token_id = next(
+        (
+            token_id
+            for token_id in reversed(prompt_token_ids)
+            if token_id in end_token_ids
+        ),
+        None,
+    )
+    if end_token_id is None:
+        return None
+    return end_text, (end_token_id,)
+
+
+def _parse_nonstream_chat_output(
+    parser: Parser,
+    request: ChatCompletionRequest,
+    conversation: list[ConversationMessage],
+    prompt_token_ids: list[int] | None,
+    model_output: str,
+    model_output_token_ids: GenericSequence[int],
+    *,
+    enable_auto_tools: bool,
+) -> tuple[str | None, str | None, list[FunctionCall] | None, int]:
+    """Parse one complete output with the same prompt state as streaming."""
+    parse_text = model_output
+    parse_token_ids: GenericSequence[int] = model_output_token_ids
+    prefix = _continued_final_reasoning_parse_prefix(
+        request, conversation, parser, prompt_token_ids
+    )
+    if prefix is not None:
+        prefix_text, prefix_token_ids = prefix
+        parse_text = prefix_text + parse_text
+        parse_token_ids = (*prefix_token_ids, *parse_token_ids)
+
+    reasoning, content, tool_calls = parser.parse(
+        parse_text,
+        request,
+        enable_auto_tools=enable_auto_tools,
+        model_output_token_ids=parse_token_ids,
+    )
+    reasoning_tokens = parser.count_reasoning_tokens(parse_token_ids)
+    return reasoning, content, tool_calls, reasoning_tokens
+
+
