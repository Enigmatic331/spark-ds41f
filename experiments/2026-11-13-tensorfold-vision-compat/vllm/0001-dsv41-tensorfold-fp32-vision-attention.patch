+@pytest.mark.parametrize("tensorfold_compat", [False, True])
+def test_tensorfold_compat_attention_is_opt_in(monkeypatch, tensorfold_compat):
+    from vllm.models.deepseek_v4.common import vision
+
+    seen = {}
+    qkv = torch.arange(36, dtype=torch.float32).reshape(3, 12).to(torch.bfloat16)
+
+    def wqkv(_x):
+        return qkv, None
+
+    def default_attention(q, k, v):
+        seen["default_dtypes"] = (q.dtype, k.dtype, v.dtype)
+        return q
+
+    def efficient_attention(q, k, v, *, dropout_p, scale):
+        seen["efficient"] = (q.shape, q.dtype, k.dtype, v.dtype, dropout_p, scale)
+        return q
+
+    def wo(x):
+        seen["wo_dtype"] = x.dtype
+        return x, None
+
+    entered_backends = []
+
+    @contextmanager
+    def record_sdpa_kernel(backend):
+        entered_backends.append(backend)
+        yield
+
+    monkeypatch.setattr(vision, "sdpa_kernel", record_sdpa_kernel)
+    monkeypatch.setattr(vision.F, "scaled_dot_product_attention", efficient_attention)
+    attention = SimpleNamespace(
+        n_heads=2,
+        head_dim=2,
+        tensorfold_compat_attention=tensorfold_compat,
+        wqkv=wqkv,
+        attn=default_attention,
+        wo=wo,
+    )
+    x = torch.zeros((3, 4), dtype=torch.bfloat16)
+    cos = torch.ones((3, 1, 1), dtype=torch.float32)
+    sin = torch.zeros_like(cos)
+
+    out = vision.DeepseekV4VisionAttention.forward(attention, x, cos, sin)
+
+    assert out.dtype == torch.bfloat16
+    assert seen["wo_dtype"] == torch.bfloat16
+    if tensorfold_compat:
+        assert "default_dtypes" not in seen
+        assert seen["efficient"] == (
+            torch.Size([1, 2, 3, 2]),
+            torch.float32,
+            torch.float32,
+            torch.float32,
+            0.0,
+            1.0 / (2**0.5),
+        )
+        assert entered_backends == [vision.SDPBackend.EFFICIENT_ATTENTION]
+    else:
+        assert seen["default_dtypes"] == (torch.bfloat16,) * 3
+        assert "efficient" not in seen
+        assert entered_backends == []
+
+
+@pytest.mark.parametrize("device", [None, torch.device("cpu")])
+def test_vision_rope_explicit_device_controls_tensor_construction(monkeypatch, device):
+    from vllm.models.deepseek_v4.common import vision
+
+    missing = object()
+    seen_devices = []
+    real_arange = torch.arange
+
+    def record_arange(*args, **kwargs):
+        seen_devices.append(kwargs.get("device", missing))
+        return real_arange(*args, **kwargs)
+
+    monkeypatch.setattr(vision.torch, "arange", record_arange)
+    vision.get_vision_cos_sin.cache_clear()
+    try:
+        vision.get_vision_cos_sin(2, 3, 4, 10_000.0, device=device)
+    finally:
+        vision.get_vision_cos_sin.cache_clear()
+
+    expected = missing if device is None else device
+    assert seen_devices == [expected, expected, expected]
+
+
+@pytest.mark.parametrize("tensorfold_compat", [False, True])
+def test_tensorfold_compat_rope_is_opt_in(monkeypatch, tensorfold_compat):
+    from vllm.models.deepseek_v4.common import vision
+
+    missing = object()
+    seen = {}
+
+    def record_rope(n_h, n_w, dim, theta, *, device=missing):
+        seen["call"] = (n_h, n_w, dim, theta, device)
+        values = torch.zeros((n_h * n_w, 1, dim), dtype=torch.float32)
+        return values, values
+
+    monkeypatch.setattr(vision, "get_vision_cos_sin", record_rope)
+    tower = SimpleNamespace(
+        rope_dim=4,
+        rope_theta=10_000.0,
+        tensorfold_compat_attention=tensorfold_compat,
+        patch_embed=lambda patches: patches,
+        blocks=(),
+        norm=lambda x: x,
+    )
+    patches = torch.zeros((6, 8), dtype=torch.bfloat16)
+
+    out = vision.DeepseekV4ViT.forward(tower, patches, 2, 3)
+
+    expected_device = patches.device if tensorfold_compat else missing
+    assert seen["call"] == (2, 3, 4, 10_000.0, expected_device)
+    assert out is patches
