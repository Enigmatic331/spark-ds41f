 )
 
 
+def _encode_images_torch(vision_model, aligner, patches, vit_grid):
+    """Reference-style per-image PyTorch tower runner.
+
+    This mirrors the non-packed control flow in the upstream multimodal
+    wrapper.  It is deliberately simple because it is a correctness fallback,
+    not the throughput path.
+    """
+    image_embeds_list = []
+    vit_offset = 0
+    for n_vit_h, n_vit_w in vit_grid:
+        n_vit = n_vit_h * n_vit_w
+        image_embeds_list.append(
+            aligner(
+                vision_model(
+                    patches[vit_offset : vit_offset + n_vit],
+                    n_vit_h,
+                    n_vit_w,
+                ),
+                n_vit_h,
+                n_vit_w,
+            )
+        )
+        vit_offset += n_vit
+    return image_embeds_list
+
+
+def _make_torch_vit(config, *, use_data_parallel):
+    """Adapt the compatibility ViT constructor to the TileLang factory API."""
+    if not use_data_parallel:
+        raise ValueError("the torch vision backend requires data parallel mode")
+    from vllm.models.deepseek_v4.common.vision import DeepseekV4ViT
+
+    return DeepseekV4ViT(config, tensorfold_compat_attention=True)
+
+
+def _make_torch_aligner(config, *, use_data_parallel):
+    """Adapt the compatibility aligner constructor to the TileLang factory API."""
+    if not use_data_parallel:
+        raise ValueError("the torch vision backend requires data parallel mode")
+    from vllm.models.deepseek_v4.common.vision import DeepseekV4Aligner
+
+    return DeepseekV4Aligner(config)
+
+
 def _vision_tower():
-    """The TileLang ViT, aligner, packed batch encoder and data-parallel image
-    runner, over the checkpoint's parameter tree."""
+    """Select the optimized TileLang tower or the PyTorch compatibility lane.
+
+    The compatibility lane reuses vLLM's existing DeepSeek-V4 reference-style
+    PyTorch modules.  It must be paired with ``--mm-encoder-tp-mode data`` so
+    every assigned image is evaluated by one complete tower.
+    """
+    backend = os.environ.get("VLLM_DSV41_VISION_BACKEND", "tilelang")
+    if backend == "torch":
+        from vllm.models.deepseek_v4.common.vision import run_dp_sharded_vision_tower
+
+        return (
+            _make_torch_vit,
+            _make_torch_aligner,
+            run_dp_sharded_vision_tower,
+            _encode_images_torch,
+        )
+    if backend != "tilelang":
+        raise ValueError(
+            "VLLM_DSV41_VISION_BACKEND must be 'tilelang' or 'torch', "
+            f"got {backend!r}"
+        )
+
+    # The optimized TileLang ViT, aligner, packed batch encoder and
+    # data-parallel image runner, over the checkpoint's parameter tree.
