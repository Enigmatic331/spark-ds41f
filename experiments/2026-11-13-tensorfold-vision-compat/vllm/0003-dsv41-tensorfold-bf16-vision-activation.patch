+def test_tensorfold_compat_activation_preserves_bf16_rounding_boundary():
+    from vllm.models.deepseek_v4.common import vision
+
+    # These BF16 values distinguish a staged BF16 SiLU + BF16 multiply from
+    # arithmetic that retains SiLU in FP32 through the multiply. This does not
+    # assume which path the ordinary CUDA SiluAndMul kernel takes.
+    gate_up = torch.tensor([[-7.8125, -6.625]], dtype=torch.bfloat16)
+    actual = vision.DeepseekV4VisionSiluAndMul()(gate_up)
+    gate = gate_up[..., :1].float()
+    up = gate_up[..., 1:].float()
+    staged_silu = (gate / (1.0 + torch.exp(-gate))).to(torch.bfloat16)
+    expected = (staged_silu.float() * up).to(torch.bfloat16)
+    fused = (
+        torch.nn.functional.silu(gate_up[..., :1].float())
+        * gate_up[..., 1:].float()
+    ).to(torch.bfloat16)
+
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    assert actual.dtype == torch.bfloat16
+    assert actual.item() == 0.0208740234375
+    assert fused.item() == 0.02099609375
+
+
+@pytest.mark.parametrize(
+    ("gate_up", "error", "message"),
+    [
+        (torch.zeros(1, 2), TypeError, "requires BF16"),
+        (
+            torch.zeros(1, 3, dtype=torch.bfloat16),
+            ValueError,
+            "width must be even",
+        ),
+    ],
+)
+def test_tensorfold_compat_activation_rejects_other_arithmetic(gate_up, error, message):
+    from vllm.models.deepseek_v4.common import vision
+
+    with pytest.raises(error, match=message):
+        vision.DeepseekV4VisionSiluAndMul()(gate_up)
+
+
+@pytest.mark.parametrize("tensorfold_compat", [False, True])
+def test_tensorfold_compat_activation_is_opt_in(monkeypatch, tensorfold_compat):
+    from torch import nn
+
+    from vllm.models.deepseek_v4.common import vision
+
+    class DefaultSiluAndMul(nn.Module):
+        def forward(self, x):
+            return x
+
+    monkeypatch.setattr(vision, "is_vit_use_data_parallel", lambda _heads: True)
+    monkeypatch.setattr(vision, "SiluAndMul", DefaultSiluAndMul)
+    monkeypatch.setattr(
+        vision,
+        "MergedColumnParallelLinear",
+        lambda *args, **kwargs: nn.Identity(),
+    )
+    monkeypatch.setattr(
+        vision,
+        "RowParallelLinear",
+        lambda *args, **kwargs: nn.Identity(),
+    )
+    config = SimpleNamespace(vision_n_heads=2, vision_dim=8, vision_inter_dim=16)
+    mlp = vision.DeepseekV4VisionMLP(
+        config,
+        tensorfold_compat_activation=tensorfold_compat,
+    )
+
+    expected_type = (
+        vision.DeepseekV4VisionSiluAndMul
+        if tensorfold_compat
+        else DefaultSiluAndMul
+    )
+    assert isinstance(mlp.act_fn, expected_type)
+
