@@ -174,8 +174,41 @@ class DeepseekV4VisionAttention(nn.Module):
         return out
 
 
+class DeepseekV4VisionSiluAndMul(nn.Module):
+    """Reference-style vision SwiGLU with an observable BF16 boundary.
+
+    Spell out the arithmetic recorded by TensorFold's Apache-2.0
+    DeepSeek-V4.1 kernel: evaluate
+    ``g / (1 + exp(-g))`` in FP32, round that result to BF16, multiply it by
+    the BF16 ``up`` value in FP32, then round the product to BF16.  The eager
+    barrier prevents an optional encoder compiler from folding away that
+    observable intermediate.  vLLM's ordinary ``SiluAndMul`` remains the
+    default path.
+    """
+
+    @torch.compiler.disable
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        if x.dtype != torch.bfloat16:
+            raise TypeError(
+                "TensorFold-compatible vision activation requires BF16 input"
+            )
+        if x.shape[-1] % 2:
+            raise ValueError("vision SwiGLU input width must be even")
+        d = x.shape[-1] // 2
+        gate = x[..., :d].float()
+        up = x[..., d:].float()
+        gate_silu = (gate / (1.0 + torch.exp(-gate))).to(x.dtype)
+        return (gate_silu.float() * up).to(x.dtype)
+
+
