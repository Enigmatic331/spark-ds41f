@@ -160,8 +160,8 @@ def test_replay_rows_anchor_at_the_prompt_end():
     assert replay_rows([4096], [0], [8192], [64], [True]) == ([64], [KEEP_ALL])
 
 
-def test_exact_warmup_replays_one_extra_swa_window():
