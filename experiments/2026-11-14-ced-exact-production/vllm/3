+        decoder_warmup = 0
+        if os.environ.get("VLLM_DS41_CED_EXACT_WARMUP") == "1":
+            hf = self.model_config.hf_config
+            boundary = ced_decoder_start(hf)
+            decoder_layers = (
+                max(int(hf.num_hidden_layers) - boundary, 0)
+                if boundary is not None
+                else 0
+            )
+            # The causal SWA receptive field grows by W-1 per layer.  Keeping
