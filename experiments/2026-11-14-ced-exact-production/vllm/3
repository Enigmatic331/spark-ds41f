+def test_decoder_warmup_extends_only_prompt_replay():
+    """Warm-up extends prompt replay while decode stays at 128 rows."""
     assert replay_rows(
         [1060], [0], [1060], [0], [False], None, CED_WINDOW - 1
     ) == ([805], [2 * CED_WINDOW - 1])
@@ -169,6 +169,11 @@ def test_exact_warmup_replays_one_extra_swa_window():
     assert replay_rows(
         [6], [1060], [1060], [0], [False], None, CED_WINDOW - 1
     ) == ([0], [CED_WINDOW])
+    # Twenty replayed decoder layers require a 2,541-row receptive field.
+    propagated = 19 * (CED_WINDOW - 1)
+    assert replay_rows(
+        [4000], [0], [4000], [0], [False], None, propagated
+    ) == ([1459], [2541])
     with pytest.raises(ValueError, match="non-negative"):
         replay_rows([1], [0], [1], [0], [False], None, -1)
 
