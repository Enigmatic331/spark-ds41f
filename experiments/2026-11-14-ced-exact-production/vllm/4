--- a/vllm/models/deepseek_v4_1/ced.py
+++ b/vllm/models/deepseek_v4_1/ced.py
@@ -39,6 +39,22 @@ def ced_decoder_start(hf_config: Any) -> int | None:
     return None
 
 
+def ced_prompt_replay_window(hf_config: Any) -> int:
+    """Return the uncached prompt suffix needed by the private CED decoder.
+
+    Normal bounded replay rebuilds one ``CED_WINDOW``.  Exact warm-up must also
+    carry that window's causal dependency frontier through every earlier
+    decoder layer.  Prefix-cache lookup uses the same value so it cannot skip
+    rows that model-state replay needs to reconstruct request-private decoder
+    pages.
+    """
+    boundary = ced_decoder_start(hf_config)
+    if boundary is None or os.environ.get("VLLM_DS41_CED_EXACT_WARMUP") != "1":
+        return CED_WINDOW
+    decoder_layers = max(int(hf_config.num_hidden_layers) - boundary, 0)
+    return CED_WINDOW + max(decoder_layers - 1, 0) * (CED_WINDOW - 1)
+
+
 def gather_rows(source: torch.Tensor, indices: torch.Tensor) -> torch.Tensor:
     """Gather first-axis rows, zeroing invalid indices (including graph padding)."""
     output = source.new_empty((indices.numel(), *source.shape[1:]))
