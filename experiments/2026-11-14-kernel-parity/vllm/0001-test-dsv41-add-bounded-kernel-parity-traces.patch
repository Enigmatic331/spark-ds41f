@@ -0,0 +1,44 @@
+import importlib
+import json
+
+import pytest
+import torch
+
+
+def _trace_module(monkeypatch, root):
+    monkeypatch.setenv("VLLM_DS41_ACCURACY_TRACE_DIR", str(root))
+    monkeypatch.setenv("VLLM_DS41_ACCURACY_TRACE_POSITION", "7")
+    from vllm.models.deepseek_v4_1 import accuracy_trace
+
+    trace = importlib.reload(accuracy_trace)
+    monkeypatch.setattr(trace, "_rank", lambda: 2)
+    return trace
+
+
+def test_positioned_trace_is_bounded_and_has_integrity_metadata(
+    monkeypatch, tmp_path
+):
+    tmp_path.chmod(0o700)
+    trace = _trace_module(monkeypatch, tmp_path)
+    values = torch.arange(12, dtype=torch.float32).reshape(3, 4).to(torch.bfloat16)
+    trace.trace_positioned(
+        "attn_in", torch.tensor([6, 7, 8]), values, layer=3
+    )
+
+    binaries = list(tmp_path.glob("*.bin"))
+    sidecars = list(tmp_path.glob("*.json"))
+    assert len(binaries) == len(sidecars) == 1
+    metadata = json.loads(sidecars[0].read_text())
+    assert metadata["dtype"] == "torch.bfloat16"
+    assert metadata["layer"] == 3
+    assert metadata["position"] == 7
+    assert metadata["rank"] == 2
+    assert metadata["shape"] == [4]
+    assert metadata["nbytes"] == binaries[0].stat().st_size == 8
+
+
+def test_trace_rejects_group_writable_directory(monkeypatch, tmp_path):
+    tmp_path.chmod(0o770)
+    trace = _trace_module(monkeypatch, tmp_path)
+    with pytest.raises(RuntimeError, match="group/world writable"):
+        trace.trace_tensor("head_in", torch.ones(2))
