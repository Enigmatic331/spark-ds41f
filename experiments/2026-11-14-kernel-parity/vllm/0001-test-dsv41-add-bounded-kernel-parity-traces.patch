diff --git a/vllm/models/deepseek_v4_1/accuracy_trace.py b/vllm/models/deepseek_v4_1/accuracy_trace.py
new file mode 100644
index 000000000..23e33dd09
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/accuracy_trace.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded, opt-in numerical traces for DS4.1 accuracy diagnosis.
+
+This module is inert unless ``VLLM_DS41_ACCURACY_TRACE_DIR`` is set before the
+worker starts. Trace runs must disable CUDA graphs. The output contains tensor
+bytes and numerical token IDs/logits only; callers must not pass request bodies,
+images, credentials, or weights.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import stat
+from pathlib import Path
+
+import torch
+
+TRACE_DIR = os.environ.get("VLLM_DS41_ACCURACY_TRACE_DIR")
+ENABLED = bool(TRACE_DIR)
+TARGET_POSITION = int(os.environ.get("VLLM_DS41_ACCURACY_TRACE_POSITION", "-1"))
+TOKEN_IDS = tuple(
+    int(item)
+    for item in os.environ.get("VLLM_DS41_ACCURACY_TRACE_TOKEN_IDS", "16,469").split(",")
+    if item.strip()
+)
+TOPK = int(os.environ.get("VLLM_DS41_ACCURACY_TRACE_TOPK", "20"))
+
+_SAFE_NAME = re.compile(r"^[a-z0-9_]+$")
+_root: Path | None = None
+_counter = 0
+_logit_call = 0
+
+
+def _trace_root() -> Path:
+    global _root
+    if _root is not None:
+        return _root
+    if not ENABLED or TRACE_DIR is None:
+        raise RuntimeError("DS4.1 accuracy tracing is disabled")
+    root = Path(TRACE_DIR)
+    info = root.lstat()
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+        raise RuntimeError("accuracy trace directory must be a real directory")
+    if info.st_mode & 0o022:
+        raise RuntimeError("accuracy trace directory must not be group/world writable")
+    _root = root.resolve(strict=True)
+    return _root
+
+
+def _rank() -> int:
+    from vllm.distributed import get_tensor_model_parallel_rank
+
+    return get_tensor_model_parallel_rank()
+
+
+def _write_exclusive(path: Path, payload: bytes) -> None:
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    descriptor = os.open(path, flags, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb", closefd=False) as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+    finally:
+        os.close(descriptor)
+
+
+def trace_tensor(
+    stage: str,
+    tensor: torch.Tensor,
+    *,
+    layer: int | None = None,
+    position: int | None = None,
+) -> None:
+    """Write one tensor and a small integrity/shape sidecar."""
+    global _counter
+    if not ENABLED:
+        return
+    if not _SAFE_NAME.fullmatch(stage):
+        raise ValueError(f"unsafe accuracy trace stage: {stage!r}")
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("accuracy tracing requires CUDA graphs to be disabled")
+    value = tensor.detach().contiguous().cpu()
+    payload = value.view(torch.uint8).numpy().tobytes()
+    serial = _counter
+    _counter += 1
+    layer_part = "na" if layer is None else f"{layer:02d}"
+    pos_part = "na" if position is None else str(position)
+    stem = f"r{_rank()}-n{serial:06d}-{stage}-l{layer_part}-p{pos_part}"
+    root = _trace_root()
+    _write_exclusive(root / f"{stem}.bin", payload)
+    metadata = {
+        "dtype": str(value.dtype),
+        "layer": layer,
+        "nbytes": len(payload),
+        "position": position,
+        "rank": _rank(),
+        "sha256": hashlib.sha256(payload).hexdigest(),
+        "shape": list(value.shape),
+        "stage": stage,
+    }
+    _write_exclusive(
+        root / f"{stem}.json",
+        (json.dumps(metadata, sort_keys=True) + "\n").encode("utf-8"),
+    )
+
+
+def trace_positioned(
+    stage: str,
+    positions: torch.Tensor,
+    tensor: torch.Tensor,
+    *,
+    layer: int | None = None,
+) -> None:
+    """Trace ``tensor``'s row whose absolute token position is configured."""
+    if not ENABLED or TARGET_POSITION < 0:
+        return
+    flat_positions = positions.reshape(-1)
+    if tensor.shape[0] != flat_positions.numel():
+        return
+    matches = torch.nonzero(flat_positions == TARGET_POSITION, as_tuple=False)
+    if matches.numel() == 0:
+        return
+    if matches.shape[0] != 1:
+        raise RuntimeError(
+            f"accuracy trace position {TARGET_POSITION} occurs {matches.shape[0]} times"
+        )
+    row = int(matches[0, 0].item())
+    trace_tensor(
+        stage,
+        tensor[row],
+        layer=layer,
+        position=TARGET_POSITION,
+    )
+
+
+def trace_logits(logits: torch.Tensor) -> None:
+    """Append competing-token values and a small top set for the last row."""
+    global _logit_call
+    if not ENABLED or logits.numel() == 0:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("accuracy tracing requires CUDA graphs to be disabled")
+    row = logits.reshape(-1, logits.shape[-1])[-1].detach()
+    valid_ids = [token_id for token_id in TOKEN_IDS if 0 <= token_id < row.shape[0]]
+    top_count = min(TOPK, row.shape[0])
+    top_values, top_ids = torch.topk(row, top_count, sorted=True)
+    record = {
+        "call": _logit_call,
+        "dtype": str(row.dtype),
+        "rank": _rank(),
+        "selected": {
+            str(token_id): float(row[token_id].item()) for token_id in valid_ids
+        },
+        "top_ids": [int(item) for item in top_ids.cpu().tolist()],
+        "top_values": [float(item) for item in top_values.cpu().tolist()],
+    }
+    _logit_call += 1
+    path = _trace_root() / f"r{_rank()}-logits.jsonl"
+    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    descriptor = os.open(path, flags, 0o600)
+    try:
+        os.write(descriptor, (json.dumps(record, sort_keys=True) + "\n").encode())
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+__all__ = ["ENABLED", "trace_logits", "trace_positioned", "trace_tensor"]
