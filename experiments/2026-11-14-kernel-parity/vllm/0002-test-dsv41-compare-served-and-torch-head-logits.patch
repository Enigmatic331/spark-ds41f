 import torch
 from torch.nn import Parameter
@@ -126,6 +127,19 @@ class PackedBf16LmHeadMethod(QuantizeMethodBase):
             packed.exponent_base + 14,
             packed.exceptions,
         )
+        if os.environ.get("VLLM_DS41_ACCURACY_TRACE_HEAD") == "1":
+            from vllm.models.deepseek_v4_1.tilelang.vocab import unpack_bf16_weight
+
+            # Diagnostic only: retain an exact BF16 reconstruction beside the
+            # packed head so LogitsProcessor can compare torch.mm with the
