From 2e1965c998907a66b824939abe82afd2f82ea13b Mon Sep 17 00:00:00 2001
From: Codex Agent <noreply@openai.com>
Date: Sat, 14 Nov 2026 03:43:27 +0800
Subject: [PATCH] test(dsv41): compare served and torch head logits

Diagnostic-only A/B from the identical hidden state and exact unpacked BF16 head. It does not alter sampled logits.

Provenance: based on imported vLLM patch head 2756478b60b9 and the preceding AI-assisted trace commit. Implemented by OpenAI Codex.
---
 .../test_deepseek_v4_1_accuracy_trace.py      | 11 +++++++
 .../model_executor/layers/logits_processor.py | 30 ++++++++++++++++++-
 .../layers/quantization/online/packed_bf16.py | 14 +++++++++
 vllm/models/deepseek_v4_1/accuracy_trace.py   |  7 +++--
 4 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_accuracy_trace.py b/tests/models/test_deepseek_v4_1_accuracy_trace.py
index 794af1955..04e0698e0 100644
--- a/tests/models/test_deepseek_v4_1_accuracy_trace.py
+++ b/tests/models/test_deepseek_v4_1_accuracy_trace.py
@@ -42,3 +42,14 @@ def test_trace_rejects_group_writable_directory(monkeypatch, tmp_path):
     trace = _trace_module(monkeypatch, tmp_path)
     with pytest.raises(RuntimeError, match="group/world writable"):
         trace.trace_tensor("head_in", torch.ones(2))
+
+
+def test_logit_sources_are_separate(monkeypatch, tmp_path):
+    tmp_path.chmod(0o700)
+    trace = _trace_module(monkeypatch, tmp_path)
+    logits = torch.arange(32, dtype=torch.float32).reshape(1, 32)
+    trace.trace_logits(logits, source="served")
+    trace.trace_logits(logits + 1, source="torch_ref")
+
+    assert len(list(tmp_path.glob("r2-served-logits.jsonl"))) == 1
+    assert len(list(tmp_path.glob("r2-torch_ref-logits.jsonl"))) == 1
diff --git a/vllm/model_executor/layers/logits_processor.py b/vllm/model_executor/layers/logits_processor.py
index 749273301..c99056d3c 100644
--- a/vllm/model_executor/layers/logits_processor.py
+++ b/vllm/model_executor/layers/logits_processor.py
@@ -354,6 +354,7 @@ class LogitsProcessor(PluggableLayer):
         embedding_bias: torch.Tensor | None = None,
         skip_gather: bool = False,
     ) -> torch.Tensor | None:
+        reference_logits = None
         if self.logits_as_input:
             logits = hidden_states
         else:
@@ -361,6 +362,23 @@ class LogitsProcessor(PluggableLayer):
             logits = self._get_logits(
                 hidden_states, lm_head, embedding_bias, skip_gather
             )
+            reference_weight = getattr(
+                lm_head, "_accuracy_trace_bf16_weight", None
+            )
+            if _DS41_ACCURACY_TRACE and reference_weight is not None:
+                if embedding_bias is not None:
+                    raise RuntimeError(
+                        "DS4.1 accuracy head trace does not accept an embedding bias"
+                    )
+                reference_logits = torch.mm(
+                    hidden_states.reshape(-1, hidden_states.shape[-1]),
+                    reference_weight.t(),
+                    out_dtype=self.head_dtype or torch.float32,
+                ).reshape(*hidden_states.shape[:-1], -1)
+                if not skip_gather and lm_head.tp_size > 1:
+                    reference_logits = self._gather_logits(reference_logits)
+                if reference_logits is not None:
+                    reference_logits = reference_logits[..., : self.org_vocab_size]
         if logits is not None:
             if self.soft_cap is not None:
                 logits = logits / self.soft_cap
@@ -369,10 +387,20 @@ class LogitsProcessor(PluggableLayer):
 
             if self.scale != 1.0:
                 logits *= self.scale
+            if reference_logits is not None:
+                if self.soft_cap is not None:
+                    reference_logits = torch.tanh(
+                        reference_logits / self.soft_cap
+                    ) * self.soft_cap
+                if self.scale != 1.0:
+                    reference_logits *= self.scale
+                from vllm.models.deepseek_v4_1.accuracy_trace import trace_logits
+
+                trace_logits(reference_logits, source="torch_ref")
             if _DS41_ACCURACY_TRACE:
                 from vllm.models.deepseek_v4_1.accuracy_trace import trace_logits
 
-                trace_logits(logits)
+                trace_logits(logits, source="served")
         return logits
 
     def _gather_logits(self, logits: torch.Tensor) -> torch.Tensor:
diff --git a/vllm/model_executor/layers/quantization/online/packed_bf16.py b/vllm/model_executor/layers/quantization/online/packed_bf16.py
index d968db77c..1be80f62c 100644
--- a/vllm/model_executor/layers/quantization/online/packed_bf16.py
