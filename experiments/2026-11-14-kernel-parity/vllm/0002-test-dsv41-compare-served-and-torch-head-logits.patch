+            layer._accuracy_trace_bf16_weight = unpack_bf16_weight(
+                self.packed_weight(layer)
+            )
+            logger.warning_once(
+                "DS4.1 accuracy trace retained an unpacked BF16 head for a "
+                "torch.mm projection comparison"
+            )
 
     def declare_layer_kernels(self, layer: torch.nn.Module) -> None:
         """With the TileLang backend, declare the packed head's projection: once the
diff --git a/vllm/models/deepseek_v4_1/accuracy_trace.py b/vllm/models/deepseek_v4_1/accuracy_trace.py
index 23e33dd09..8eed55136 100644
--- a/vllm/models/deepseek_v4_1/accuracy_trace.py
+++ b/vllm/models/deepseek_v4_1/accuracy_trace.py
@@ -139,11 +139,13 @@ def trace_positioned(
     )
 
 
-def trace_logits(logits: torch.Tensor) -> None:
+def trace_logits(logits: torch.Tensor, *, source: str = "served") -> None:
     """Append competing-token values and a small top set for the last row."""
     global _logit_call
     if not ENABLED or logits.numel() == 0:
         return
+    if not _SAFE_NAME.fullmatch(source):
+        raise ValueError(f"unsafe accuracy trace logit source: {source!r}")
     if torch.cuda.is_current_stream_capturing():
         raise RuntimeError("accuracy tracing requires CUDA graphs to be disabled")
     row = logits.reshape(-1, logits.shape[-1])[-1].detach()
@@ -154,6 +156,7 @@ def trace_logits(logits: torch.Tensor) -> None:
         "call": _logit_call,
         "dtype": str(row.dtype),
         "rank": _rank(),
+        "source": source,
         "selected": {
             str(token_id): float(row[token_id].item()) for token_id in valid_ids
         },
@@ -161,7 +164,7 @@ def trace_logits(logits: torch.Tensor) -> None:
         "top_values": [float(item) for item in top_values.cpu().tolist()],
     }
     _logit_call += 1
-    path = _trace_root() / f"r{_rank()}-logits.jsonl"
+    path = _trace_root() / f"r{_rank()}-{source}-logits.jsonl"
     flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
     if hasattr(os, "O_NOFOLLOW"):
         flags |= os.O_NOFOLLOW
