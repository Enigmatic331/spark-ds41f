-__all__ = ["ENABLED", "trace_logits", "trace_positioned", "trace_tensor"]
+__all__ = [
+    "ENABLED",
+    "positions_for_tensor",
+    "trace_logits",
+    "trace_positioned",
+    "trace_tensor",
+]
