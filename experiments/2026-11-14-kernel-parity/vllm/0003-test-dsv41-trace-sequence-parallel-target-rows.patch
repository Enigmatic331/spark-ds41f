+++ b/vllm/models/deepseek_v4_1/accuracy_trace.py
@@ -139,6 +139,26 @@ def trace_positioned(
     )
 
 
+def positions_for_tensor(
+    positions: torch.Tensor,
+    tensor: torch.Tensor,
+    sp_rows: object | None,
+) -> torch.Tensor:
+    """Return positions matching a replicated or sequence-parallel tensor.
+
+    Prefill sequence parallelism keeps only this rank's contiguous row slice,
+    while decode rows are replicated. This helper is intentionally duck-typed
+    so the diagnostic module does not import the serving-only SPRows class.
+    """
+    if tensor.shape[0] == positions.numel():
+        return positions
+    if sp_rows is not None:
+        local_positions = sp_rows.local_slice(positions)
+        if tensor.shape[0] == local_positions.numel():
+            return local_positions
+    return positions
+
+
 def trace_logits(logits: torch.Tensor, *, source: str = "served") -> None:
     """Append competing-token values and a small top set for the last row."""
     global _logit_call
@@ -176,4 +196,10 @@ def trace_logits(logits: torch.Tensor, *, source: str = "served") -> None:
