 vllm/models/deepseek_v4_1/accuracy_trace.py   | 28 ++++++++++++++++++-
 vllm/models/deepseek_v4_1/nvidia/model.py     | 19 ++++++++++---
 3 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_accuracy_trace.py b/tests/models/test_deepseek_v4_1_accuracy_trace.py
index 04e0698e0..d238b106b 100644
--- a/tests/models/test_deepseek_v4_1_accuracy_trace.py
+++ b/tests/models/test_deepseek_v4_1_accuracy_trace.py
@@ -53,3 +53,22 @@ def test_logit_sources_are_separate(monkeypatch, tmp_path):
 
     assert len(list(tmp_path.glob("r2-served-logits.jsonl"))) == 1
     assert len(list(tmp_path.glob("r2-torch_ref-logits.jsonl"))) == 1
+
+
+def test_positions_for_sequence_parallel_tensor(monkeypatch, tmp_path):
+    class Rows:
+        @staticmethod
+        def local_slice(value: torch.Tensor) -> torch.Tensor:
+            return value[4:8]
+
+    trace = _trace_module(monkeypatch, tmp_path)
+    positions = torch.arange(12)
+    local_tensor = torch.empty(4, 3)
+    replicated_tensor = torch.empty(12, 3)
+    assert torch.equal(
+        trace.positions_for_tensor(positions, local_tensor, Rows()),
+        positions[4:8],
+    )
+    assert trace.positions_for_tensor(
+        positions, replicated_tensor, Rows()
+    ) is positions
