+++ b/vllm/models/deepseek_v4_1/nvidia/model.py
@@ -431,7 +431,7 @@ class DeepseekV4DecoderLayer(nn.Module):
                     if ced_input_ids is None
                     else ced_input_ids
                 )
-        if accuracy_trace.ENABLED:
+        if accuracy_trace.active():
             trace_positions = accuracy_trace.positions_for_tensor(
                 positions, x, sp_rows
             )
@@ -460,7 +460,7 @@ class DeepseekV4DecoderLayer(nn.Module):
             attn_pre,
         )
         del attn_pre
-        if accuracy_trace.ENABLED:
+        if accuracy_trace.active():
             trace_positions = accuracy_trace.positions_for_tensor(
                 positions, x, sp_rows
             )
@@ -1165,7 +1165,7 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
                 if out is None
                 else self.norm(hidden_states, out)
             )
-        if accuracy_trace.ENABLED:
+        if accuracy_trace.active():
             trace_positions = accuracy_trace.positions_for_tensor(
                 positions, hidden_states, sp
             )
diff --git a/vllm/models/deepseek_v4_1/tilelang/router.py b/vllm/models/deepseek_v4_1/tilelang/router.py
index f55454156..05a7587fa 100644
--- a/vllm/models/deepseek_v4_1/tilelang/router.py
+++ b/vllm/models/deepseek_v4_1/tilelang/router.py
@@ -1205,7 +1205,7 @@ class TileLangGateRouter(TileKernelsRouter):
     ) -> tuple[torch.Tensor, torch.Tensor]:
         from .. import accuracy_trace
 
-        if not accuracy_trace.ENABLED:
+        if not accuracy_trace.active():
             return topk_weights, topk_ids
         positions = getattr(self, "_accuracy_trace_positions", None)
         layer = getattr(self, "_accuracy_trace_layer", None)
