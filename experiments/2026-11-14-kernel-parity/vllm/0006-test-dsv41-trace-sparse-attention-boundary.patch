+def test_positioned_trace_accepts_integer_index_metadata(monkeypatch, tmp_path):
+    tmp_path.chmod(0o700)
+    trace = _trace_module(monkeypatch, tmp_path)
+    values = torch.tensor([[1, -1], [2, 3], [4, 5]], dtype=torch.int32)
+    trace.trace_positioned(
+        "index_selected", torch.tensor([6, 7, 8]), values, layer=21
+    )
+
+    sidecar = next(tmp_path.glob("*.json"))
+    metadata = json.loads(sidecar.read_text())
+    assert metadata["dtype"] == "torch.int32"
+    assert metadata["shape"] == [2]
+    assert metadata["layer"] == 21
+
+
 def test_selected_logit_trace_is_local_and_separate(monkeypatch, tmp_path):
