     )
 
 
+def target_row(positions: torch.Tensor) -> int | None:
+    """Return the unique configured-position row, or ``None`` when absent."""
+    if not active() or TARGET_POSITION < 0:
+        return None
+    matches = torch.nonzero(
+        positions.reshape(-1) == TARGET_POSITION, as_tuple=False
+    )
+    if matches.numel() == 0:
+        return None
+    if matches.shape[0] != 1:
+        raise RuntimeError(
+            f"accuracy trace position {TARGET_POSITION} occurs {matches.shape[0]} times"
+        )
+    return int(matches[0, 0].item())
+
+
