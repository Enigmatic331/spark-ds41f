+    @staticmethod
+    def _raw_cache_records(cache, physical_slots, page_size, record_bytes):
+        """Gather raw byte records for already validated physical slots."""
+        slots = physical_slots.to(torch.int64)
+        pages = torch.div(slots, page_size, rounding_mode="floor")
+        offsets = torch.remainder(slots, page_size)
+        columns = offsets[:, None] * record_bytes + torch.arange(
+            record_bytes, dtype=torch.int64, device=cache.device
+        )[None, :]
+        return cache[pages[:, None], columns]
+
+    def _trace_attention_cache_records(
+        self,
+        positions,
+        swa_indices,
+        swa_lengths,
+        main,
+        owner,
+        top_lengths,
+        indexed_page_table,
+    ):
+        """Trace only the target row's selected raw cache records.
+
+        This distinguishes cache-content drift from sparse-MLA schedule drift
+        without copying an entire request's cache or any request text.
+        """
+        row = accuracy_trace.target_row(positions)
+        if row is None:
+            return
+        position = accuracy_trace.TARGET_POSITION
+        swa_length = int(swa_lengths[row].item())
+        swa_slots = swa_indices[row, :swa_length]
+        accuracy_trace.trace_tensor(
+            "swa_physical_slots",
+            swa_slots,
+            layer=self.layer_id,
+            position=position,
+        )
+        accuracy_trace.trace_tensor(
+            "swa_records",
+            self._raw_cache_records(
+                self.swa_cache_layer.kv_cache,
+                swa_slots,
+                self.swa_cache_layer.block_size,
+                528,
+            ),
+            layer=self.layer_id,
+            position=position,
+        )
+        if main is None or indexed_page_table is None:
+            return
+        indexed_length = int(top_lengths[row].item())
+        logical = owner.topk_indices_buffer[row, :indexed_length].to(torch.int64)
+        logical_pages = torch.div(logical, self._main_page, rounding_mode="floor")
+        physical_pages = indexed_page_table[row, logical_pages].to(torch.int64)
+        physical_slots = physical_pages * self._main_page + torch.remainder(
+            logical, self._main_page
+        )
+        accuracy_trace.trace_tensor(
+            "indexed_physical_slots",
+            physical_slots,
+            layer=self.layer_id,
+            position=position,
+        )
+        accuracy_trace.trace_tensor(
+            "indexed_records",
+            self._raw_cache_records(
+                owner.kv_cache,
+                physical_slots,
+                self._main_page,
+                288,
+            ),
+            layer=self.layer_id,
+            position=position,
+        )
