+@tilelang.jit(pass_configs=_PASS)
+def target_exact_rejection_kernel(
+    width: int, target_dtype: str, drafts_dtype: str
+):
+    """Commit an exact target-sampled prefix, a warp per request.
+
+    ``target_sampled`` contains one independently sampled target token for every
+    verification row. A draft is accepted only while it equals the target draw
+    at that position. The first mismatch commits the target draw; a fully
+    accepted draft block commits the bonus row's target draw.
+    """
+    if not 1 <= width <= 32:
+        raise ValueError(f"{width} sampled tokens a request: a warp takes them")
+    reqs, cu_len, target_len, drafts_len = T.dynamic(
+        "reqs, cu_len, target_len, drafts_len"
+    )
+
+    @T.prim_func
+    def target_exact_rejection(
+        sampled: T.Tensor((reqs, width), T.int64),
+        num_sampled: T.Tensor((reqs,), T.int32),
+        target_sampled: T.Tensor((target_len,), target_dtype),
+        draft_sampled: T.Tensor((drafts_len,), drafts_dtype),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+    ):
+        with T.Kernel(reqs, threads=32) as req:
+            tx = T.get_thread_binding()
+            targets = T.alloc_shared((width,), T.int64)
+            drafts = T.alloc_shared((width,), T.int64)
+            accepted = T.alloc_local((1,), T.int64)
+            verifying = T.alloc_local((1,), T.int32)
+            start = T.alloc_var(T.int64, init=T.cast(cu_num_logits[req], T.int64))
+            num_drafts = T.alloc_var(
+                T.int64, init=T.cast(cu_num_logits[req + 1], T.int64) - start - 1
+            )
+            if (tx < width) & (T.cast(tx, T.int64) <= num_drafts):
+                targets[tx] = T.cast(target_sampled[start + tx], T.int64)
+                if T.cast(tx, T.int64) < num_drafts:
+                    drafts[tx] = T.cast(draft_sampled[start + tx + 1], T.int64)
+            T.sync_threads()
+            if tx == 0:
+                accepted[0] = 0
+                verifying[0] = 1
+                for i in tuple(range(width - 1)):
+                    if (num_drafts > i) & (verifying[0] != 0):
+                        # -1 is a padding/disabled draft and can never be accepted.
+                        if (targets[i] == drafts[i]) & (drafts[i] >= 0):
+                            sampled[req, i] = drafts[i]
+                            accepted[0] = accepted[0] + 1
+                        else:
+                            sampled[req, i] = targets[i]
+                            verifying[0] = 0
+                if accepted[0] == num_drafts:
+                    sampled[req, num_drafts] = targets[num_drafts]
+                num_sampled[req] = T.cast(accepted[0] + 1, T.int32)
+
+    return target_exact_rejection
+
+
+def target_exact_rejection_key(
+    width: int, target_dtype: torch.dtype, drafts_dtype: torch.dtype
+) -> tuple:
+    return (width, _DTYPES[target_dtype], _DTYPES[drafts_dtype])
+
+
+def target_exact_rejection_sample(
+    target_sampled: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_speculative_steps: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return the committed prefix from position-keyed target samples."""
+    if target_sampled.ndim != 1 or draft_sampled.ndim != 1:
+        raise ValueError("target and draft samples must be one-dimensional")
+    if target_sampled.shape != draft_sampled.shape:
+        raise ValueError("target and draft sample rows must have the same shape")
+    num_reqs = cu_num_logits.shape[0] - 1
+    sampled = draft_sampled.new_empty(
+        num_reqs, num_speculative_steps + 1, dtype=torch.int64
+    )
+    num_sampled = sampled.new_empty(num_reqs, dtype=torch.int32)
+    if num_reqs > 0:
+        kernel = _kernel(
+            target_exact_rejection_kernel,
+            *target_exact_rejection_key(
+                num_speculative_steps + 1,
+                target_sampled.dtype,
+                draft_sampled.dtype,
+            ),
+        )
+        kernel(sampled, num_sampled, target_sampled, draft_sampled, cu_num_logits)
+    return sampled, num_sampled
+
+
 # --- Temperature --------------------------------------------------------------
 
 
