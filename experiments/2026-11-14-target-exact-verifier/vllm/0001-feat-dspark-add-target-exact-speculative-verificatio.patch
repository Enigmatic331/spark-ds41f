+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Position-keyed target samples commit the serial target prefix exactly."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.sample import tilelang_sampling
+
+DEVICE = "cuda"
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+
+
+def _reference(
+    target: torch.Tensor,
+    drafts: torch.Tensor,
+    offsets: list[int],
+    width: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    sampled = torch.empty((len(offsets) - 1, width), dtype=torch.int64)
+    counts = torch.empty(len(offsets) - 1, dtype=torch.int32)
+    target = target.cpu()
+    drafts = drafts.cpu()
+    for req, (start, end) in enumerate(zip(offsets, offsets[1:])):
+        num_drafts = end - start - 1
+        accepted = 0
+        for step in range(num_drafts):
+            draft = int(drafts[start + step + 1])
+            expected = int(target[start + step])
+            if draft >= 0 and draft == expected:
+                sampled[req, step] = draft
+                accepted += 1
+            else:
+                sampled[req, step] = expected
+                break
+        if accepted == num_drafts:
+            sampled[req, num_drafts] = target[start + num_drafts]
+        counts[req] = accepted + 1
+    return sampled, counts
+
+
+@pytest.mark.parametrize("draft_dtype", [torch.int32, torch.int64])
+def test_target_exact_commits_only_the_matching_prefix(draft_dtype):
+    drafts_per_req = [5, 3, 0, 5, 1, 4]
+    accepted_per_req = [5, 1, 0, 2, 0, 3]
+    offsets = [0]
+    for count in drafts_per_req:
+        offsets.append(offsets[-1] + count + 1)
+
+    target = torch.arange(offsets[-1], dtype=torch.int64, device=DEVICE) + 100
+    drafts = torch.full(
+        (offsets[-1],), -777, dtype=draft_dtype, device=DEVICE
+    )
+    for req, (count, accepted) in enumerate(
+        zip(drafts_per_req, accepted_per_req)
+    ):
+        start = offsets[req]
+        for step in range(count):
+            if step < accepted:
+                drafts[start + step + 1] = target[start + step]
+            elif step == accepted:
+                # Exercise both an ordinary mismatch and the -1 placeholder.
+                drafts[start + step + 1] = (
+                    -1 if req % 2 else target[start + step] + 1
+                )
+            else:
+                # These rows are target outputs for a rejected speculative suffix
+                # and must never affect the committed result.
+                drafts[start + step + 1] = target[start + step]
+
+    cu = torch.tensor(offsets, dtype=torch.int32, device=DEVICE)
+    sampled, counts = tilelang_sampling.target_exact_rejection_sample(
+        target, drafts, cu, num_speculative_steps=5
+    )
+    expected, expected_counts = _reference(target, drafts, offsets, width=6)
+
+    assert torch.equal(counts.cpu(), expected_counts)
+    for req, count in enumerate(expected_counts.tolist()):
+        assert torch.equal(sampled[req, :count].cpu(), expected[req, :count])
+
+
+def test_target_exact_declaration_covers_both_step_widths():
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.v1.worker.gpu.spec_decode.rejection_sampler import RejectionSampler
+
+    owner = RejectionSampler.__new__(RejectionSampler)
+    owner.sampler = SimpleNamespace(
+        use_fp64_gumbel=False,
+        logprobs_mode="raw_logprobs",
+    )
+    owner.num_speculative_steps = 9
+    owner.num_draft_steps = 5
+    owner.watermark_key = None
+    owner.use_block_verification = False
+    owner.use_target_exact_verification = True
+    owner.synthetic_conditional_rates = None
+
+    registry = JitWarmupRegistry(None)
+    with registry.activate():
+        owner.register_warmups(
+            logits=[(torch.bfloat16, 129408)],
+            processed_logits=[(torch.float32, 129280)],
+            vocab_size=129280,
+            has_draft_logits=False,
+            dead_rows=True,
+        )
+    calls = prepare.declared_calls(registry)
+    declared = {
+        args
+        for factory, args, _ in calls
+        if factory is tilelang_sampling.target_exact_rejection_kernel
+    }
+    assert declared == {
+        (6, "int64", "int32"),
+        (6, "int64", "int64"),
+        (10, "int64", "int32"),
+        (10, "int64", "int64"),
+    }
+
+
+def test_target_exact_rejects_incompatible_shapes():
+    target = torch.zeros(4, dtype=torch.int64, device=DEVICE)
+    drafts = torch.zeros(3, dtype=torch.int32, device=DEVICE)
+    cu = torch.tensor([0, 4], dtype=torch.int32, device=DEVICE)
+    with pytest.raises(ValueError, match="same shape"):
+        tilelang_sampling.target_exact_rejection_sample(target, drafts, cu, 3)
