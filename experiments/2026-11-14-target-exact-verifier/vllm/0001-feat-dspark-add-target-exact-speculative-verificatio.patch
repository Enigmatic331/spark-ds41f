     return _unique(calls)
 
 
+def target_exact_rejection_calls(widths: Sequence[int]) -> list:
+    """Exact target-prefix commit calls for the runner's token dtypes."""
+    return _unique(
+        [
+            _call(
+                target_exact_rejection_kernel,
+                *target_exact_rejection_key(width, torch.int64, drafts_dtype),
+            )
+            for width in widths
+            for drafts_dtype in (torch.int32, torch.int64)
+        ]
+    )
+
+
 def gumbel_finish_calls(vocab_size: int) -> list:
     """The finish of Gumbel-max sampling of ``vocab_size``-wide logits."""
     num_blocks = -(-vocab_size // GUMBEL_BLOCK)
